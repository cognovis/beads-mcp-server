#!/usr/bin/env bash
# Idempotent macmaint update for the owned SDK v2 beads MCP package.
set -euo pipefail

SSH_HOST="dolt-server"
REMOTE_DIR="/opt/beads-mcp-server"
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"

if ! ssh -o BatchMode=yes -o ConnectTimeout=10 "$SSH_HOST" true 2>/dev/null; then
  echo "dolt-server unreachable; skipping beads-mcp update"
  exit 0
fi

RSYNC_OUT="$(rsync -azi \
  "$SCRIPT_DIR/pyproject.toml" "$SCRIPT_DIR/uv.lock" "$SCRIPT_DIR/.env.example" \
  "$SSH_HOST:$REMOTE_DIR/" 2>&1 || true)"
RSYNC_SRC="$(rsync -azi "$SCRIPT_DIR/src/" "$SSH_HOST:$REMOTE_DIR/src/" 2>&1 || true)"

if test -n "$RSYNC_OUT$RSYNC_SRC"; then
  echo "package changed; syncing locked environment and restarting"
  ssh "$SSH_HOST" "cd $REMOTE_DIR && uv sync --frozen --no-dev"
  echo "restarting beads-mcp-server..."
  ssh "$SSH_HOST" "systemctl restart beads-mcp-server && systemctl is-active beads-mcp-server"
fi
echo "verifying health..."
ssh "$SSH_HOST" "curl -fsS http://127.0.0.1:8092/health >/dev/null && echo '  health: ok'"
