# Operator-provided static bearer token. Never commit a real value.
BEADS_MCP_TOKEN=<static-bearer-token>
HOST=127.0.0.1
PORT=8092
MCP_PATH=/mcp
MCP_PUBLIC_URL=https://beads.example.com/mcp
MCP_ALLOWED_HOSTS=beads.example.com,beads.example.com:*
MCP_ALLOWED_ORIGINS=

# Immediate child directory names become exact workspace IDs. No path or alias inference occurs.
BEADS_WORKSPACE_ROOT=/srv/beads-workspaces
BEADS_READINESS_WORKSPACE_ID=project-a
BEADS_PATH=/usr/bin/bd
BEADS_ACTOR=beads-mcp
BEADS_COMMAND_TIMEOUT_SECONDS=30
BEADS_MAX_OUTPUT_BYTES=4194304

# Passed only to bd through the explicit child-environment allowlist.
BEADS_DOLT_SERVER_HOST=127.0.0.1
BEADS_DOLT_SERVER_PORT=3306
BEADS_DOLT_SERVER_USER=beads
BEADS_DOLT_PASSWORD=<from secure operator-provided source>
