# beads MCP HTTP service (FastMCP, static bearer)
# Generate the token: python -c "import secrets;print(secrets.token_urlsafe(36))"
BEADS_MCP_TOKEN=<static-bearer-token>
HOST=127.0.0.1
PORT=8092
MCP_PATH=/mcp
BEADS_WORKING_DIR=/opt/beads-workspaces
BEADS_PATH=/usr/bin/bd
# Central Dolt SQL server on this host
DOLT_HOST=127.0.0.1
DOLT_PORT=3306
DOLT_USER=malte
BEADS_DOLT_PASSWORD=<from secure operator-provided source>
# Hot repos pre-warmed at startup (comma-separated, optional)
BEADS_PREWARM_REPOS=mira,polaris
