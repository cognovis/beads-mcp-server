# Operator-provided static bearer token. Never commit a real value.
BEADS_MCP_TOKEN=<static-bearer-token>
HOST=127.0.0.1
PORT=8092
MCP_PATH=/mcp
MCP_PUBLIC_URL=https://dolt.cognovis.de/mcp
MCP_ALLOWED_HOSTS=dolt.cognovis.de,dolt.cognovis.de:*
MCP_ALLOWED_ORIGINS=

# Stable identifiers are part of every tool call. Paths are never accepted from clients.
BEADS_WORKSPACES_JSON={"hetzner":"/opt/beads-workspaces/hetzner","mira":"/opt/beads-workspaces/mira","polaris":"/opt/beads-workspaces/polaris"}
BEADS_PATH=/usr/bin/bd
BEADS_ACTOR=beads-mcp
BEADS_COMMAND_TIMEOUT_SECONDS=30
BEADS_MAX_OUTPUT_BYTES=4194304

# Passed only to bd through the explicit child-environment allowlist.
BEADS_DOLT_SERVER_HOST=127.0.0.1
BEADS_DOLT_SERVER_PORT=3306
BEADS_DOLT_SERVER_USER=malte
BEADS_DOLT_PASSWORD=<from secure operator-provided source>
